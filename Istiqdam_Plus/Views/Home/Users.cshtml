<div class="p-6 bg-gray-50 min-h-screen">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">المستخدمون</h1>
        <p class="text-sm text-gray-500">إجمالي المستخدمين: 3</p>
    </div>

    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 mb-6 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <button class="p-2 border rounded-lg hover:bg-gray-50"><i class="fas fa-edit"></i></button>
            <button class="p-2 border rounded-lg hover:bg-gray-50"><i class="fas fa-filter"></i></button>
            <button class="p-2 border rounded-lg hover:bg-gray-50"><i class="fas fa-sync"></i></button>
        </div>

        <div class="flex items-center gap-3">
            <input type="text" placeholder="بحث..." class="border rounded-lg px-4 py-2 w-64 text-right focus:ring-2 focus:ring-teal-500 outline-none">
            <label class="flex items-center gap-2 text-sm font-medium">
                <input type="checkbox" checked class="w-4 h-4 text-teal-600"> النشطون فقط
            </label>
            <select class="border rounded-lg px-3 py-2 text-sm">
                <option>مدير النظام</option>
            </select>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-right">
            <thead class="bg-gray-50 border-b border-gray-100">
                <tr>
                    <th class="p-4 text-sm font-bold text-gray-600">#</th>
                    <th class="p-4 text-sm font-bold text-gray-600">الاسم الكامل</th>
                    <th class="p-4 text-sm font-bold text-gray-600">اسم المستخدم</th>
                    <th class="p-4 text-sm font-bold text-gray-600">الدور</th>
                    <th class="p-4 text-sm font-bold text-gray-600">الحالة</th>
                    <th class="p-4 text-sm font-bold text-gray-600">تاريخ الإنشاء</th>
                    <th class="p-4 text-sm font-bold text-gray-600">آخر دخول</th>
                    <th class="p-4 text-sm font-bold text-gray-600 text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <tr>
                    <td class="p-4">1</td>
                    <td class="p-4">مدير النظام</td>
                    <td class="p-4">admin</td>
                    <td class="p-4">مدير النظام</td>
                    <td class="p-4"><span class="bg-green-50 text-green-600 px-3 py-1 rounded-full text-xs font-bold">نشط</span></td>
                    <td class="p-4">2026/05/15</td>
                    <td class="p-4">قبل 3 ساعات</td>
                    <td class="p-4 text-center">
                        <button class="text-gray-400 hover:text-red-500 mx-1">🗑️</button>
                        <button class="text-gray-400 hover:text-blue-500 mx-1">✏️</button>
                        <button class="text-gray-400 hover:text-yellow-500 mx-1">🔒</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
