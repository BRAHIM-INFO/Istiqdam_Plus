@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="bg-teal-600 rounded-[32px] p-10 text-white shadow-2xl mb-8 relative overflow-hidden">
    <h1 class="text-4xl font-bold mb-2">مرحباً، مستخدم 👋</h1>
    <p class="text-teal-50 opacity-90">أهلاً بك في نظام استقدام بلس لإدارة العمالة.</p>
</div>

<div class="bg-white p-4 rounded-[24px] shadow-lg flex items-center mb-10 border border-gray-100">
    <span class="px-4 text-2xl">🔍</span>
    <input type="text" placeholder="البحث السريع عن موظف..." class="w-full p-3 outline-none text-lg">
    <button class="bg-teal-600 text-white px-8 py-4 rounded-[20px] font-bold">بحث</button>
</div>

<div class="grid grid-cols-6 gap-4 mb-8">
    @for (int i = 0; i < 6; i++)
    {
        <div class="bg-white p-6 rounded-[24px] shadow-sm border border-gray-100 text-center">
            <div class="text-2xl mb-2">🏆</div>
            <h2 class="text-3xl font-bold">0</h2>
            <p class="text-gray-500 text-sm">إجمالي الموظفين</p>
        </div>
    }
</div>

<div class="grid grid-cols-4 gap-4">
    <button class="bg-white p-6 rounded-[24px] shadow-sm border border-gray-100 flex flex-col items-center hover:bg-gray-50 transition">
        <span class="text-3xl mb-2">➕</span> إضافة موظف جديد
    </button>
</div>

