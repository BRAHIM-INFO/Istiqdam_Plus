@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-teal-700 to-teal-900 h-screen flex items-center justify-center">

    <div class="backdrop-blur-xl bg-white/10 border border-white/20 p-10 rounded-[40px] shadow-2xl text-center w-[450px]">

        <div class="mb-6">
            <svg class="w-20 h-20 mx-auto text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
        </div>

        <h1 class="text-3xl font-bold text-white mb-2">نظام استقدام بلس</h1>
        <p class="text-teal-100 mb-8">للإدارة الاحترافية للعمالة</p>

        <div class="w-full bg-black/20 rounded-full h-3 overflow-hidden">
            <div id="progress" class="bg-teal-400 h-full w-0 transition-all duration-[3000ms] ease-out"></div>
        </div>
        <p class="text-white/60 text-sm mt-4">جاري استعادة قاعدة البيانات المحلية...</p>
    </div>

    <script>
        // تفعيل شريط التحميل والانتقال التلقائي
        window.onload = () => {
            const progress = document.getElementById('progress');
            progress.style.width = '100%';

                   // في ملف Splash.cshtml
           setTimeout(() => {
               window.location.href = '@Url.Action("Login", "Account")';
           }, 3200);

            // الانتقال بعد انتهاء التحميل (3 ثوانٍ)
            // setTimeout(() => {
            //         window.location.href = '@Url.Action("Index", "Home")'; // تأكد أنه يذهب لصفحة المحتوى الرئيسية
            //   }, 4200); 
        };
    </script>
</body>
</html>