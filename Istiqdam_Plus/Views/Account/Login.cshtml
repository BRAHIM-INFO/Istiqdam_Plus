@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Cairo', sans-serif; } </style>
</head>
<body class="bg-gradient-to-br from-teal-700 to-teal-900 h-screen flex items-center justify-center">

    <div class="backdrop-blur-xl bg-white/10 border border-white/20 p-8 rounded-[40px] shadow-2xl text-center w-[400px]">
        <div class="w-20 h-20 bg-teal-600 rounded-full flex items-center justify-center mx-auto mb-4 border-4 border-white/10">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
        </div>

        <h1 class="text-2xl font-bold text-white mb-6">دخول آمن للنظام</h1>

        <form action="/Home/Index" method="post" class="space-y-4">
            <input type="text" placeholder="اسم المستخدم" class="w-full p-4 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-teal-400">
            <input type="password" placeholder="كلمة المرور" class="w-full p-4 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-teal-400">

            <div class="text-right">
                <a href="#" class="text-sm text-teal-100 hover:underline">نسيت كلمة المرور؟</a>
            </div>

            <button type="submit" class="w-full py-4 bg-teal-600 hover:bg-teal-500 text-white rounded-xl font-bold transition">
                تسجيل الدخول
            </button>
        </form>
    </div>
</body>
</html>